# Copy this file to .env.production on EC2. Never commit the real file.
# The host "postgres" is the PostgreSQL service alias inside cv-online_default.
DATABASE_URL=postgresql://taskflow_user:CHANGE_ME@postgres:5432/taskflow?schema=public

PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://YOUR_ELASTIC_IP.sslip.io
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_64_RANDOM_HEX_CHARACTERS
COOKIE_DOMAIN=YOUR_ELASTIC_IP.sslip.io

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Change this only if `docker network ls` shows a different CV-Online network.
CV_ONLINE_NETWORK=cv-online_default

